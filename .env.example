# Copiá este archivo a .env y completá con los datos de tu proyecto (Settings → API keys en Supabase).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# Solo para los scripts de administración (invite, set-password, backup, check). Nunca en el navegador ni en el repo.
SUPABASE_SECRET_KEY=sb_secret_...
# Opcional, para aplicar el esquema desde la terminal (npm run migrate): botón Connect → Session pooler, con la contraseña.
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres
